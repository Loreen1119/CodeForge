# 复制为 .env 并填写（.env 已 gitignore，不会泄露）
OPENAI_API_KEY=sk-你的Key
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
API_KEY=可选，设置后接口需带 X-API-Key 头
RATE_LIMIT_RPS=10

# production hardening (optional for local demo)
APP_ENV=development
ENFORCE_API_KEY=false
CORS_ORIGINS=http://localhost:5173
